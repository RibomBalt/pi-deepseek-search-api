{
  "name": "pi-ds-webapi",
  "version": "0.1.0",
  "description": "DeepSeek Search and Fetch tools for Pi",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "files": [
    "extensions/",
    "README.md"
  ],
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "vitest run tests/setup.test.ts tests/deepseek-client.test.ts tests/deepseek-web.test.ts",
    "test:unit": "vitest run tests/setup.test.ts tests/deepseek-client.test.ts tests/deepseek-web.test.ts",
    "test:integration": "vitest run tests/pi-live.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/deepseek-web.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "typebox": "^1.4.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
